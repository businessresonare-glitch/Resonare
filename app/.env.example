# Full-screen looping hero background video.
# Any direct-play MP4 URL reachable from the browser.
VITE_HERO_VIDEO_URL=https://your-cdn.example.com/path/to/hero.mp4

# Origin serving the static pages (/services.html, /work.html, ...).
# Leave empty in production, where the hero and those pages share an origin.
# Set to e.g. https://resonare.digital so nav links resolve against the dev server.
VITE_SITE_BASE_URL=
